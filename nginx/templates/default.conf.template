server {
  listen ${NGINX_PORT};
  listen [::]:${NGINX_PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /favicon.ico {
    alias /usr/share/nginx/html/static/icons/favicon.ico;
  }

  location /config/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires 0 always;
    try_files $uri =404;
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Example: standard HTTP upstream
  # Replace the path and upstream according to the real backend route.
  location /example-http/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Example: WebSocket upstream
  # Typical use cases: chat, realtime status, live collaboration.
  location /example-ws/ {
    proxy_pass ${API_UPSTREAM};
    include /etc/nginx/templates/ws_common.conf;
  }

  # Example: SSE upstream
  # Typical use cases: LLM token streaming, progress events, notifications.
  location /example-sse/ {
    proxy_pass ${API_UPSTREAM};
    include /etc/nginx/templates/sse_common.conf;
  }

  location /login {
    proxy_pass ${AUTH_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /logout {
    proxy_pass ${AUTH_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /callback {
    proxy_pass ${AUTH_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /user/ {
    proxy_pass ${AUTH_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
