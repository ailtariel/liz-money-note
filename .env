# ============================
# Vite variables
# Only effective in local development.
# They are consumed by vite.config.ts and are not part of runtime client config.
# ============================

# Local dev server proxy target for API requests.
VITE_API_PROXY_TARGET=http://localhost:8080

# Local dev server proxy target for auth-related requests.
VITE_AUTH_PROXY_TARGET=http://localhost:8080

# ============================
# App runtime config
# Effective for the client in all environments.
# In production, APP_* values are injected at container/pod startup.
# In local development, Vite generates public/config/env-config.json from merged .env* files.
# ============================

# Browser tab title.
APP_APP_TITLE=Vue Skeleton

# Client-side API base URL.
APP_API_BASE_URL=/api

# Whether route guards are enabled.
APP_ENABLE_ROUTE_GUARD=true

# Default route after login or guest-only redirect.
APP_DEFAULT_ROUTE=/

# Feature flag example.
APP_FEATURE_FLAGS__SHOW_ABOUT=true

# Default Vuetify theme.
APP_VUETIFY__DEFAULT_THEME=light

# ============================
# SQLite database build config
# Consumed by Node/Vite build scripts. DB_* values are not exposed as runtime
# client config.
# ============================

# SQLite CLI executable used by database initialization scripts.
DB_SQLITE_PATH=C:\Software\SQLite\sqlite3.exe

# Logical SQLite database name used by Capacitor SQLite.
DB_NAME=liz_money_note

# Database filename copied into web/android assets.
DB_FILE_NAME=liz_money_note.db

# Generated database asset directory.
DB_ASSET_DIR=public/assets/databases

# SQLite encryption mode passed to Capacitor SQLite.
DB_ENCRYPTION_MODE=no-encryption

# SQLite database version passed to Capacitor SQLite.
DB_VERSION=1

# ============================
# Nginx runtime variables
# Only effective in production container runtime.
# These values are used by nginx template rendering, so use NG_ prefix.
# ============================

# Nginx listen port inside the container.
NG_PORT=8080

# Upstream endpoint for /api and example proxy locations.
NG_API_UPSTREAM=http://host.docker.internal:8080

# Upstream endpoint for /login /logout /callback /user.
NG_AUTH_UPSTREAM=http://host.docker.internal:8080
